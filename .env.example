# ========================================================
# TEMPLATE KONFIGURASI FIREBASE - KIMIAKU
# ========================================================
# Salin file ini menjadi .env pada folder KimiaKu lalu isi
# dengan kredensial aplikasi Web dari Firebase Console:
# Firebase Console > Project Settings > General > Your apps (Web SDK)
#
# CATATAN:
# Jika variabel ini belum diisi atau dikosongkan, aplikasi KimiaKu
# akan secara otomatis berjalan dalam Mode Tamu Lokal (Local Guest Mode)
# secara aman tanpa crash, dan seluruh progres serta skor kuis
# tetap tersimpan di penyimpanan lokal peramban (localStorage).
# ========================================================

VITE_FIREBASE_API_KEY=AIzaSyA_ContohApiKeyFirebaseAnda12345
VITE_FIREBASE_AUTH_DOMAIN=projek-kimia-anda.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=projek-kimia-anda
VITE_FIREBASE_STORAGE_BUCKET=projek-kimia-anda.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
